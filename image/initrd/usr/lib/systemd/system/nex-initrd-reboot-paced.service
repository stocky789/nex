[Unit]
Description=Reboot a boot that failed in the initrd, after a pause
DefaultDependencies=no
# The initrd root account is locked, so a shell here would only refuse the login. A reboot is the one recovery that
# needs no input: a transient fault (a slow disk, a late array) clears, and an operator can pick another entry in the
# boot menu. An armed entry already spent one of its tries in the menu, so these reboots end in the previous image;
# a blessed entry has no counter, and the pause keeps that loop slow and the console readable.

[Service]
Type=oneshot
StandardOutput=journal+console
ExecStartPre=/usr/bin/sleep 60
ExecStart=/usr/bin/systemctl --force reboot
