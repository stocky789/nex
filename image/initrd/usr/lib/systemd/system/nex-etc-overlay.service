[Unit]
Description=Mount the persistent /etc overlay
DefaultDependencies=no
# The /sysroot/var mount unit is generated by initrd-parse-etc from the image fstab, so name it explicitly.
Requires=sysroot-var.mount
After=initrd-root-fs.target initrd-parse-etc.service sysroot-var.mount
Before=initrd-fs.target
ConditionPathExists=/etc/initrd-release

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/bin/mkdir -p /sysroot/var/lib/nex/etc/upper /sysroot/var/lib/nex/etc/work
# Options stay at the kernel defaults (index, metacopy, redirect_dir, xino off): the lower is replaced
# by every image update and must still mount under the same upper (spike S3).
ExecStart=/usr/bin/mount -t overlay overlay -o lowerdir=/sysroot/etc,upperdir=/sysroot/var/lib/nex/etc/upper,workdir=/sysroot/var/lib/nex/etc/work /sysroot/etc

[Install]
RequiredBy=initrd-fs.target
