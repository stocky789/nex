[Unit]
Description=Reboot a counted boot that failed in the initrd
DefaultDependencies=no
# sd-boot sets LoaderBootCountPath only while the entry it booted still carries a "+tries" counter. Then a reboot
# costs one try and ends in the previous image once the tries are used up. A blessed entry has no counter: nothing
# would ever stop the reboots, so the condition fails and nex-initrd-reboot-paced.service takes over.
ConditionPathExists=/sys/firmware/efi/efivars/LoaderBootCountPath-4a67b082-0a4c-41cf-b6c7-440b29bb8c4f

[Service]
Type=oneshot
ExecStart=/usr/bin/systemctl --force reboot
