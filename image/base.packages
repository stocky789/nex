# Packages of the Nex Core base image (one per line; '#' comments).
# Host tools, minus what ships as signed layers (nex-zfs: zfsutils-linux; nex-cluster: corosync,
# pacemaker, sanlock, fence agents, sbd, dlm-controld, gfs2-utils; smb: cifs-utils, smbclient),
# plus boot and image packages.
# Debian is the package source only; the host never runs apt or dpkg (image-lock.py pins this set).

# Virtualisation
qemu-system-x86
qemu-utils
libvirt-daemon-system
libvirt-clients
ovmf
python3-virt-firmware
swtpm
swtpm-tools

# Networking and base services
openssh-server
nftables
chrony
ifupdown
bridge-utils
vlan
dhcpcd-base
iproute2
ca-certificates

# Storage clients and RAID
mdadm
nfs-common
libnfs-utils
open-iscsi
libiscsi7
libblkid1

# Platform tools used by Core
python3
genisoimage
dmidecode
pciutils
ipmitool
fdisk
dosfstools
e2fsprogs
erofs-utils
dmsetup
efibootmgr

# Curated diagnostics
procps
less
strace
tcpdump
ethtool
smartmontools
iperf3

# Boot chain (UKI, systemd-boot, shim) and kernel; no initramfs tooling is used on the host
systemd
systemd-sysv
systemd-container
systemd-boot
systemd-boot-efi
systemd-boot-efi-amd64-signed
shim-signed
# BIOS boot: grub-install --target=i386-pc runs on the host (nex-hostimage esp-sync) when a replaced disk lacks boot code
grub2-common
grub-common
grub-pc-bin
udev
dbus
kmod
linux-image-amd64

# Console sign-in: agetty executes login(1), which Debian marks Priority required but not Essential, so mkosi
# installs it only when it is listed. Without it neither the serial nor the VGA console can log anyone in.
login
