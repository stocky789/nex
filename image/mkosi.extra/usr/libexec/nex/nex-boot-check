#!/bin/sh
# Boot assessment: fails only for image-caused problems (state or config not writable, libvirt or Core
# not running, the state format guard refusing, a layer check failing). Never looks at links, quorum,
# peers, the clock or the Controller.
# On failure of a counted boot (boot counter active) the host reboots: the entry is tried again while the
# boot counter has tries left and marked bad on the last one, so the menu falls back to the previous image.
# Nothing happens while /run/nex/maintenance-hold exists.
#
# NEX_BOOT_CHECK_TRIES (default 20), NEX_BOOT_CHECK_WAIT seconds (default 10) and NEX_BOOT_CHECK_BUDGET seconds
# (default 600) bound how long a slow start is given before the image is judged; a lab shortens them in a unit
# drop-in. Every external command that can hang runs under timeout(1), and no new check starts once the budget is
# used up, so the whole run ends within the budget plus one command timeout and the verdict (bad / reboot below)
# is always reached before the unit's TimeoutStartSec (900) kills the script.
set -u

tries=${NEX_BOOT_CHECK_TRIES:-20}
wait_seconds=${NEX_BOOT_CHECK_WAIT:-10}
budget=${NEX_BOOT_CHECK_BUDGET:-600}
# Whole seconds of uptime: monotonic, unlike the wall clock the boot may still be stepping, and dash has no $SECONDS.
now() { cut -d. -f1 /proc/uptime; }
deadline=$(($(now) + budget))
problems=""
note() { problems="$problems $*;"; }

check_once() {
    problems=""
    timeout 20 sh -c 'mkdir -p /var/lib/nex/image && : > "$1" && rm -f "$1"' sh /var/lib/nex/image/.boot-check.$$ || note "/var is not writable"
    [ "$(findmnt -no FSTYPE /etc)" = overlay ] || note "/etc is not the persistent overlay"
    timeout 20 sh -c ': > "$1" && rm -f "$1"' sh /etc/.nex-boot-check.$$ || note "/etc is not writable"
    systemctl is-failed --quiet nex-state-guard.service && note "retained state needs a newer state_format than this image reads"
    if [ -x /usr/sbin/libvirtd ]; then
        timeout 30 virsh -q -c qemu:///system version > /dev/null 2>&1 || note "libvirtd does not answer"
    fi
    if systemctl is-enabled --quiet nex-core-local.service 2> /dev/null; then
        systemctl is-active --quiet nex-core-local.service || note "nex-core-local is not running"
    fi
    for check in /usr/lib/nex/boot-check.d/*; do
        [ -x "$check" ] || continue
        [ "$(now)" -lt "$deadline" ] || { note "time budget used up before $(basename "$check")"; break; }
        timeout 30 "$check" > /dev/null 2>&1 || note "$(basename "$check") failed or took over 30 s"
    done
    [ -z "$problems" ]
}

attempts=0
until check_once; do
    attempts=$((attempts + 1))
    [ "$attempts" -lt "$tries" ] || break
    [ "$(now)" -lt "$deadline" ] || break
    sleep "$wait_seconds"
done
[ -z "$problems" ] && exit 0

echo "nex-boot-check:$problems" >&2
if [ -e /run/nex/maintenance-hold ]; then
    exit 1
fi
# A counted boot: the menu already decremented the entry's counter for this boot. While tries are left the
# failure only costs this boot: reboot and let the menu try again. On the last try mark the entry bad so the next
# boot is the previous image; the menu then falls back by itself. nex-hostimage boot-tries prints the tries left
# (0 = exhausted) and nothing once the running entry is blessed.
left=$(/usr/bin/nex-hostimage boot-tries 2> /dev/null || true)
if [ -n "$left" ]; then
    if [ "$left" -gt 0 ]; then
        echo "nex-boot-check: $left boot tries left, rebooting to try again" >&2
    else
        timeout 60 /usr/bin/nex-hostimage bless bad
    fi
    systemctl --no-block reboot
fi
exit 1
