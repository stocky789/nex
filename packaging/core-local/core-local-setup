# SPDX-License-Identifier: AGPL-3.0-only
"""Root-only local management configuration; does not alter host networking."""
import argparse
import ipaddress
import json
import os
from pathlib import Path
import re
import subprocess

CONFIG = Path('/etc/nex/core-local.env')
STATE = Path('/var/lib/nex/core-local')
BUNDLE = Path('/usr/share/nex/appliance')
# Image edition: the Controller system image is an on-demand payload outside the verified slot, one directory per digest.
PAYLOAD = Path('/var/lib/nex/payload')
ISSUE = Path('/run/issue.d/50-nex-local.issue')


def console_notice(text):
    ISSUE.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
    ISSUE.parent.chmod(0o755)
    temporary = ISSUE.with_suffix('.tmp')
    temporary.write_text('\n' + text + '\n')
    temporary.chmod(0o644)
    temporary.replace(ISSUE)
    # Refresh waiting login prompts without interrupting an authenticated session.
    try:
        subprocess.run(['/sbin/agetty', '--reload'], check=False,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass  # The notice remains available to the next login prompt.


def controller_system_image(config):
    """(path, sha256) of the Controller system image for Core's two-disk profile, or None for the single-disk appliance.

    `configure --controller-image-sha256` names the vm-image release component by the digest in the signed release
    manifest; the image itself is the on-demand payload Core fetched, under /var/lib/nex/payload/<sha256>/.
    """
    digest = config.get('controller_image_sha256', '')
    if not digest:
        return None
    if not re.fullmatch(r'[0-9a-f]{64}', digest):
        raise ValueError('controller_image_sha256 is not a SHA-256 digest')
    return PAYLOAD / digest / 'controller-system.img', digest


def configure(address, storage, bridge, automatic=False, controller_image_sha256=None):
    ip = ipaddress.ip_address(address)
    if ip.is_unspecified or ip.is_multicast:
        raise ValueError('select a specific management IP address')
    path = Path(storage)
    if not path.is_absolute() or not path.is_dir() or path.is_symlink():
        raise ValueError('storage must be an existing absolute directory, not a symlink')
    if bridge and not re.fullmatch(r'[A-Za-z0-9_.-]{1,15}', bridge):
        raise ValueError('invalid bridge name')
    if bridge and not Path('/sys/class/net', bridge, 'bridge').is_dir():
        raise ValueError('select an existing Linux bridge')
    CONFIG.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    temporary = CONFIG.with_suffix('.tmp')
    values = {'address': str(ip), 'storage': str(path), 'bridge': bridge, 'automatic': automatic}
    if controller_image_sha256 is None and CONFIG.exists():
        controller_image_sha256 = json.loads(CONFIG.read_text()).get('controller_image_sha256')
    if controller_image_sha256:
        if not re.fullmatch(r'[0-9a-f]{64}', controller_image_sha256):
            raise ValueError('the Controller image digest must be 64 lowercase hex characters')
        values['controller_image_sha256'] = controller_image_sha256
    temporary.write_text(json.dumps(values) + '\n')
    temporary.chmod(0o600)
    temporary.replace(CONFIG)


def discover():
    routes = json.loads(subprocess.check_output(['ip', '-j', '-4', 'route', 'show', 'default'], text=True))
    addresses = json.loads(subprocess.check_output(['ip', '-j', '-4', 'address', 'show'], text=True))
    devices = {route.get('dev') for route in routes}
    for interface in addresses:
        if interface.get('ifname') not in devices:
            continue
        for entry in interface.get('addr_info', []):
            if entry.get('scope') != 'global':
                continue
            ip = ipaddress.ip_address(entry['local'])
            if ip.is_loopback or ip.is_unspecified or ip.is_multicast or ip.is_link_local:
                continue
            bridge = interface['ifname'] if Path('/sys/class/net', interface['ifname'], 'bridge').is_dir() else ''
            return str(ip), bridge
    raise ValueError('No management IPv4 on a default-route interface; root must run core-local-setup configure --address IP --storage DIRECTORY [--bridge BRIDGE], then restart nex-core-local.')


def initialize(config):
    STATE.mkdir(mode=0o700, parents=True, exist_ok=True)
    STATE.chmod(0o700)
    cert, key = STATE / 'tls.crt', STATE / 'tls.key'
    # OpenSSL 3.0 exits 0 for -checkip whether or not the address matches; read the verdict.
    matches = cert.exists() and key.exists() and b' does match certificate' in subprocess.run(
        ['openssl', 'x509', '-in', str(cert), '-noout', '-checkip', config['address']],
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL).stdout
    if not matches:
        subprocess.run(['openssl', 'req', '-x509', '-newkey', 'rsa:3072', '-nodes',
                        '-days', '365', '-subj', '/CN=Nex Core local management',
                        '-addext', 'subjectAltName=IP:' + config['address'],
                        '-keyout', str(key), '-out', str(cert)], check=True,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    # The host root account is now the sole credential authority; never modify it.
    for legacy in ('initial-password', 'credentials.json'):
        (STATE / legacy).unlink(missing_ok=True)
    address = config['address']
    host = '[' + address + ']' if ':' in address else address
    # Pre-login agetty shows /etc/issue then /run/issue.d; keep this short and factual.
    notice = f'Local web UI: https://{host}:9443\n'
    Path('/etc/motd.d').mkdir(exist_ok=True)
    Path('/etc/motd.d/50-nex-local').write_text(notice)
    console_notice(notice)
    print(notice, end='')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=['configure', 'init', 'run', 'prepare-recovery', 'offline'])
    parser.add_argument('--request-file', help='root-private recovery deployment JSON file')
    parser.add_argument('--address')
    parser.add_argument('--storage')
    parser.add_argument('--bridge', default='')
    parser.add_argument('--controller-image-sha256', help='configure: deploy the two-disk read-only Controller profile from this vm-image release component (image edition); pass "" to return to the single-disk appliance')
    args = parser.parse_args()
    if os.geteuid() != 0:
        parser.error('root is required')
    os.umask(0o077)
    if args.action == 'offline':
        console_notice('Local web UI: unavailable\n'
                       'Check: systemctl status nex-core-local\n')
        return
    if args.action == 'configure':
        if not all([args.address, args.storage]):
            parser.error('configure requires --address and --storage; --bridge is optional until deployment')
        configure(args.address, args.storage, args.bridge, controller_image_sha256=args.controller_image_sha256)
        print('Configured. Run systemctl restart nex-core-local to apply.')
        return
    if args.action == 'init':
        console_notice('Local web UI: starting (waiting for management address)\n')
    config = json.loads(CONFIG.read_text()) if CONFIG.exists() else {}
    if args.action == 'init' and (not config or config.get('automatic')):
        address, bridge = discover()
        storage = Path('/var/lib/libvirt/images')
        storage.mkdir(mode=0o711, parents=True, exist_ok=True)
        configure(address, str(storage), bridge, automatic=True)
        config = json.loads(CONFIG.read_text())
    if args.action == 'init':
        initialize(config)
        return
    host = '[' + config['address'] + ']' if ':' in config['address'] else config['address']
    profile = controller_system_image(config)
    argv = ['/usr/lib/nex/nex-core-local', '--listen', host + ':9443',
            '--data-dir', str(STATE), '--agent-state-dir', '/var/lib/nex-core-agent',
            '--tls-cert', str(STATE / 'tls.crt'), '--tls-key', str(STATE / 'tls.key'),
            '--ui-dir', '/usr/share/nex/core-local/web',
            '--docs-dir', '/usr/share/nex/core-local/api',
            '--source-archive', '/usr/share/nex/core-local/nex-source.tar.gz',
            '--storage-dir', config['storage'], '--bridge', config['bridge'],
            '--libvirt-uri', 'qemu:///system']
    if profile:
        # The digest in the signed release manifest is the only integrity check of the system image.
        argv += ['--controller-system-image', str(profile[0]), '--controller-system-image-sha256', profile[1]]
    else:
        argv += ['--image', str(BUNDLE / 'controller.qcow2'), '--manifest', str(BUNDLE / 'manifest.json'),
                 '--signature', str(BUNDLE / 'manifest.sig'), '--trusted-key', str(BUNDLE / 'release.pub')]
    if args.action == 'prepare-recovery':
        if not args.request_file:
            parser.error('prepare-recovery requires --request-file')
        argv.extend(['--prepare-recovery-file', args.request_file])
    os.execv(argv[0], argv)


if __name__ == '__main__':
    main()
