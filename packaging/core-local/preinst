#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-only
set -eu
# Nex Core is a distribution: the hypervisor host, its installer, its management
# agent and its host configuration are one product. Installing this package onto an
# arbitrary Debian system produces something that resembles a Nex Core host without
# being one, so a fresh install requires the system stamp that only the Nex Core
# installer, or an earlier Nex Core install, writes.
#
# This is a product boundary, not a security control: root can write the stamp.
root=${DPKG_ROOT:-}
stamp=$root/etc/nex/core-release

# "install" with no second argument is a brand new install. Upgrades and reinstalls
# over an existing configuration are always allowed, so hosts provisioned before this
# check shipped keep upgrading normally.
if [ "$1" = install ] && [ -z "${2:-}" ] && [ ! -f "$stamp" ]; then
    cat >&2 <<'MESSAGE'
nex-core-local: this system was not installed from the Nex Core ISO.

Nex Core is a Debian-based distribution, not an add-on for an existing Debian
system. Storage layout, networking, console identity, host configuration and the
recovery paths are established by the Nex Core installer; this package alone does
not produce a supported virtualization host.

Install Nex Core from its ISO instead: https://nexvirtualization.com
MESSAGE
    exit 1
fi
