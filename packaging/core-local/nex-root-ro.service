[Unit]
Description=Mount the Nex Core root file system read-only
Documentation=file:///usr/share/doc/nex-core-local/copyright
DefaultDependencies=no
# systemd-remount-fs applies fstab's options to / and would otherwise make it writable again.
After=systemd-remount-fs.service
Before=local-fs.target
# Only a host installed with the read-only layout: /etc and /var are mounts, so / carries no
# state. Any other host keeps its writable root.
ConditionPathIsMountPoint=/etc
ConditionPathIsMountPoint=/var

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/mount -o remount,ro /

[Install]
WantedBy=local-fs.target
