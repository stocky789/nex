#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-only
set -eu
# DPKG_ROOT is set by dpkg for chrootless installs (empty on a live host).
root=${DPKG_ROOT:-}
if [ "$1" = configure ]; then
    install -d -m755 "$root/etc/nex"
    # The system stamp preinst requires. The installer writes it before installing
    # any package; creating it here only backfills hosts provisioned before the
    # check shipped, and never overwrites the installer's own provenance.
    if [ ! -f "$root/etc/nex/core-release" ]; then
        printf 'NEX_CORE=1\nINSTALLED_BY=package-upgrade\n' > "$root/etc/nex/core-release"
    fi
    if [ ! -f "$root/etc/nex/updates.conf" ] || grep -Eq 'repo_url=http://(127\.|10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.)' "$root/etc/nex/updates.conf"; then
        printf 'repo_url=https://nexvirtualization.com/apt\n' > "$root/etc/nex/updates.conf"
    fi
    # Configure the Nex APT source so the repo is present out of the box, signed by the
    # packaged archive key. The base URL follows repo_url; the suite/component are the repo's.
    repo=$(sed -n 's/^repo_url=//p' "$root/etc/nex/updates.conf" | head -1)
    [ -n "$repo" ] || repo=https://nexvirtualization.com/apt
    install -d -m755 "$root/etc/apt/sources.list.d" "$root/etc/apt/apt.conf.d"
    cat > "$root/etc/apt/apt.conf.d/91nex-core-storage-downgrade" <<'APT'
DPkg::Pre-Install-Pkgs {"/usr/lib/nex/storage-downgrade-guard --core";};
DPkg::Tools::Options::/usr/lib/nex/storage-downgrade-guard::Version "3";
APT
    cat > "$root/etc/apt/sources.list.d/nex.sources" <<APT
Types: deb
URIs: $repo
Suites: nex
Components: main
Architectures: amd64
Signed-By: /usr/share/keyrings/nex-archive-keyring.gpg
APT
    # OpenZFS is in Debian contrib, which hosts installed before Nex enabled it do
    # not have. Add only that component, only to the Debian source Nex itself wrote,
    # and only to Components lines that lack it, so operator edits survive. apt
    # cannot run here (dpkg holds its lock); the next update applies the change.
    debian_sources=$root/etc/apt/sources.list.d/debian.sources
    if [ ! -f "$debian_sources" ]; then
        echo "nex-core-local: $debian_sources not found; enable the Debian contrib component yourself to install OpenZFS"
    elif grep -E '^Components:.*[[:space:]]main([[:space:]]|$)' "$debian_sources" |
         grep -qvE '[[:space:]]contrib([[:space:]]|$)'; then
        # A sources file that cannot be edited costs ZFS support, never the update.
        if sed -i -E '/^Components:.*[[:space:]]main([[:space:]]|$)/{/[[:space:]]contrib([[:space:]]|$)/!s/$/ contrib/}' "$debian_sources"; then
            echo "nex-core-local: enabled the Debian contrib component in $debian_sources for OpenZFS"
        else
            echo "nex-core-local: could not enable the Debian contrib component in $debian_sources; OpenZFS stays unavailable"
        fi
    fi
    # Cluster packages are installed with Core so an explicit pool configuration
    # has every native binary available. Only a host with no Corosync configuration
    # at all is safe to disable here; an administrator or already configured Nex
    # cluster must survive an upgrade untouched.
    if [ ! -e "$root/etc/corosync/corosync.conf" ]; then
        for unit in corosync.service dlm.service pacemaker.service pcsd.service pcsd-ruby.service; do
            deb-systemd-helper disable "$unit"
            if [ -z "$root" ] && [ -d /run/systemd/system ]; then
                deb-systemd-invoke stop "$unit" || true
            fi
        done
    fi
    # sbd is the watchdog self-fencing daemon. Debian's package leaves its unit ENABLED on
    # install, and the unit is RequiredBy=corosync.service, so on a host that already runs a
    # cluster the next corosync start would pull sbd in with Debian's own configuration
    # instead of Nex Core's — and if it could not start, corosync would not either. A watchdog
    # is armed only when a pool asks for it, so this is disabled unconditionally, including on
    # a host that already has a Corosync configuration. It is never stopped here: disabling an
    # enabled unit is inert, and stopping a service under a live cluster is not.
    # Nex Core re-enables it when a pool's Host fencing setting and prerequisites call for it.
    # A host whose sbd Nex Core already manages is left alone: an ordinary package upgrade
    # must not disarm a pool, and it would — disabling is inert on the running unit, so
    # nothing would look wrong until each host's next reboot came up unarmed.
    if ! grep -qs '^# Managed by Nex Core' "$root/etc/default/sbd"; then
        deb-systemd-helper disable sbd.service
    fi
    # Nex Core's release identity is this package's version: the distribution and
    # the software Nex ships on it are one thing. Divert Debian's package-owned
    # symlink once so the local /etc file wins without touching /usr/lib/os-release.
    if [ "$(dpkg-divert --truename /etc/os-release)" = /etc/os-release ]; then
        dpkg-divert --local --add --rename --divert /etc/os-release.debian /etc/os-release
    fi
    version=$(dpkg-query -W -f='${Version}' nex-core-local)
    codename=$(. "$root/usr/lib/os-release" && printf '%s' "${VERSION_CODENAME:-trixie}")
    cat > "$root/etc/os-release" <<RELEASE
NAME="Nex Core"
PRETTY_NAME="Nex Core $version"
ID=nex-core
ID_LIKE=debian
VERSION="$version"
VERSION_ID=$version
DEBIAN_CODENAME=$codename
RELEASE
    # The installer writes the console identity from PRETTY_NAME; keep it current.
    for banner in "$root/etc/motd" "$root/etc/issue"; do
        [ -f "$banner" ] && sed -i "s/^Nex Core [^ ]*/Nex Core $version/" "$banner" || true
    done
    # Quiet systemd-ssh-generator when AF_VSOCK is unavailable (bare metal / no vsock).
    install -d -m755 "$root/etc/default/grub.d"
    grub_cfg=$root/etc/default/grub.d/nex-core.cfg
    if [ ! -f "$grub_cfg" ] || ! grep -Fq 'systemd.ssh_auto=no' "$grub_cfg"; then
        printf '%s\n' \
            'GRUB_DISTRIBUTOR="Nex Core"' \
            'GRUB_CMDLINE_LINUX_DEFAULT="${GRUB_CMDLINE_LINUX_DEFAULT:+$GRUB_CMDLINE_LINUX_DEFAULT }systemd.ssh_auto=no"' \
            > "$grub_cfg"
        if [ -z "$root" ] &&
           [ "$(stat -c %d:%i / 2>/dev/null || echo x)" = \
             "$(stat -Lc %d:%i /proc/1/root 2>/dev/null || echo y)" ] &&
           command -v update-grub >/dev/null 2>&1; then
            update-grub || true
        fi
    fi
    # Enable in installer chroots too; native Debian policy controls starting services.
    # Write the local include always; reload the live profile only on the booted host.
    # Debian Installer's in-target sees the live kernel AppArmor flag (and often a
    # bind-mounted sysfs .load), but apparmor_parser then fails and would abort
    # package configure under set -e. Defer reload until first boot outside the chroot.
    apparmor_profile=/etc/apparmor.d/usr.sbin.libvirtd
    in_chroot=no
    if [ "$(stat -c %d:%i / 2>/dev/null || echo x)" != \
         "$(stat -Lc %d:%i /proc/1/root 2>/dev/null || echo y)" ]; then
        in_chroot=yes
    fi
    apparmor_live=no
    if [ -z "$root" ] && [ "$in_chroot" = no ] &&
       [ -r /sys/module/apparmor/parameters/enabled ] &&
       grep -qx 'Y' /sys/module/apparmor/parameters/enabled &&
       [ -f "$apparmor_profile" ] &&
       [ -e /sys/kernel/security/apparmor/.load ]; then
        apparmor_live=yes
    fi
    if [ "$apparmor_live" = yes ] && ! command -v apparmor_parser >/dev/null 2>&1; then
        echo "AppArmor is active but apparmor_parser is unavailable; cannot activate Nex storage guard" >&2
        exit 1
    fi
    # Preserve administrator policy and add only Nex's narrow hook execution rule.
    policy_helper="$root/usr/lib/nex/libvirtd-apparmor-policy"
    if [ -x "$policy_helper" ]; then
        "$policy_helper" "$root" install
    fi
    if [ "$apparmor_live" = yes ]; then
        apparmor_parser -r "$apparmor_profile"
    fi
    deb-systemd-helper enable nex-core-local.service
    # The initramfs script that persists /etc and /root on a read-only-root host only
    # takes effect once an initramfs contains it. It acts on any host whose fstab has a
    # /var entry, not only installer-laid ones: such a host moves /etc and /root onto /var
    # and mounts / read-only from its next boot. nex-root-ro.service only acts where /etc
    # and /var are mounts.
    deb-systemd-helper enable nex-root-ro.service
    if [ -z "$root" ]; then
        dpkg-trigger update-initramfs
    fi
    # libvirt discovers qemu.d hooks only when its daemon starts. Refresh an
    # already-running legacy daemon so the safety hook applies to later starts.
    # A libvirtd restart reconnects to running QEMU guests; it does not stop them.
    if [ -z "$root" ] && [ -d /run/systemd/system ] &&
       systemctl is-active --quiet libvirtd.service; then
        systemctl try-restart libvirtd.service
    fi
    if [ -z "$root" ] && [ -d /run/systemd/system ]; then
        systemctl daemon-reload
        # In-GUI apply writes update-progress.json then runs dpkg; restarting here
        # kills that process before it can finish and mark the update done.
        progress=/var/lib/nex/core-local/update-progress.json
        if [ -f "$progress" ] && grep -qE '"phase":[[:space:]]*"(downloading|installing|restarting)"' "$progress"; then
            :
        else
            deb-systemd-invoke restart nex-core-local.service || true
        fi
    fi
fi
