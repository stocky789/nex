# SPDX-License-Identifier: AGPL-3.0-only
[Unit]
Description=Nex Core local management and Controller appliance deployment
Wants=network-online.target
After=network-online.target libvirtd.service
Conflicts=nex-core-agent.service

[Service]
Type=simple
User=root
UMask=0077
# core-local embeds the agent, so systemd must create both of its private stores
# before core-local-setup starts.  The standalone agent unit's StateDirectory does
# not apply while this unit owns the embedded agent.
StateDirectory=nex/core-local nex-core-agent
StateDirectoryMode=0700
# Creates the host key that seals SMB mount credentials (systemd-creds encrypt needs it).
ExecStartPre=-/usr/bin/systemd-creds setup
# The backup credential receipt key is sealed in the state directory and loaded into the service
# as a credential. A missing file would fail the unit, so the first start creates it here; Core
# creates it itself only when it is missing while running.
ExecStartPre=/bin/sh -c 'f=/var/lib/nex-core-agent/backup-credential-key/key.cred; [ -e "$f" ] || { mkdir -p -m 0700 "${f%/*}" && head -c 32 /dev/urandom | systemd-creds --no-ask-password encrypt --name=nex-backup-key - "$f"; }'
LoadCredentialEncrypted=nex-backup-key:/var/lib/nex-core-agent/backup-credential-key/key.cred
ExecStartPre=/usr/lib/nex/core-local-setup init
ExecStart=/usr/lib/nex/core-local-setup run
ExecStopPost=/usr/lib/nex/core-local-setup offline
# Restart=always, not on-failure: a management-network change arms a rollback that only
# runs when this service is running again, so a clean exit (an exit 0, a killed process
# reaped as success) must not leave the host on an unconfirmed network with nothing armed.
# `systemctl stop` and a package upgrade still stop the unit; only an exit does not.
Restart=always
RestartSec=5
NoNewPrivileges=yes
# The embedded agent verifies ISO storage as libvirt-qemu with runuser.
AmbientCapabilities=CAP_SETUID
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
