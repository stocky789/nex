#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-only
set -eu
if [ "$1" = remove ]; then
    # Without the initramfs script the next boot shows the stale /etc the installer left
    # on /, not the host's configuration on /var, so removal is refused there.
    if mountpoint -q /etc; then
        echo "nex-core-local: this host keeps /etc on /var; removing Nex Core would boot the stale /etc left on /" >&2
        exit 1
    fi
    /usr/lib/nex/storage-downgrade-guard --core --check
    # Same live-load gate as postinst: installer/chroot trees must not fail remove
    # because the live kernel AppArmor flag is visible without a usable policy load path.
    apparmor_profile=/etc/apparmor.d/usr.sbin.libvirtd
    in_chroot=no
    if [ "$(stat -c %d:%i / 2>/dev/null || echo x)" != \
         "$(stat -Lc %d:%i /proc/1/root 2>/dev/null || echo y)" ]; then
        in_chroot=yes
    fi
    apparmor_live=no
    if [ -z "${DPKG_ROOT:-}" ] && [ "$in_chroot" = no ] &&
       [ -r /sys/module/apparmor/parameters/enabled ] &&
       grep -qx 'Y' /sys/module/apparmor/parameters/enabled &&
       [ -f "$apparmor_profile" ] &&
       [ -e /sys/kernel/security/apparmor/.load ]; then
        apparmor_live=yes
    fi
    if [ "$apparmor_live" = yes ] && ! command -v apparmor_parser >/dev/null 2>&1; then
        echo "AppArmor is active but apparmor_parser is unavailable; cannot remove Nex storage guard policy" >&2
        exit 1
    fi
    /usr/lib/nex/libvirtd-apparmor-policy "${DPKG_ROOT:-}" remove
    if [ "$apparmor_live" = yes ]; then
        apparmor_parser -r "$apparmor_profile"
    fi
    if [ -d /run/systemd/system ]; then
        deb-systemd-invoke stop nex-core-local.service
    fi
    deb-systemd-helper disable nex-core-local.service nex-root-ro.service
    # Remove the generated apt source so removal never leaves a source whose key is gone.
    rm -f "${DPKG_ROOT:-}/etc/apt/sources.list.d/nex.sources" "${DPKG_ROOT:-}/etc/apt/apt.conf.d/91nex-core-storage-downgrade"
fi
# Guest disks, VM definitions, configuration and credentials intentionally survive removal.
