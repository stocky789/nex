#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-only
set -eu
if [ "$1" = configure ]; then
    if ! getent passwd nex-controller >/dev/null; then
        useradd --system --home /var/lib/nex-controller --shell /usr/sbin/nologin nex-controller
    fi
    install -d -m700 -o nex-controller -g nex-controller /var/lib/nex-controller
    install -d -m700 -o nex-controller -g nex-controller /etc/nex-controller
    # Keep credentials readable by the service user across package upgrades.
    chown -R nex-controller:nex-controller /etc/nex-controller /var/lib/nex-controller
    find /etc/nex-controller -type f -exec chmod 600 {} +
    find /etc/nex-controller -type d -exec chmod 700 {} +
    install -d -m755 /etc/nex
    if [ ! -f /etc/nex/updates.conf ] || grep -Eq 'repo_url=http://(127\.|10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.)' /etc/nex/updates.conf; then
        printf 'repo_url=https://nexvirtualization.com/apt\n' > /etc/nex/updates.conf
    fi
    # Configure the Nex APT source so apply-update can upgrade through apt, signed by
    # the packaged archive key. The base URL follows repo_url; suite/component are the
    # repo's. apply-update rewrites this if the repo URL changes later.
    repo=$(sed -n 's/^repo_url=//p' /etc/nex/updates.conf | head -1)
    [ -n "$repo" ] || repo=https://nexvirtualization.com/apt
    install -d -m755 /etc/apt/sources.list.d /etc/apt/apt.conf.d
    cat > /etc/apt/apt.conf.d/91nex-controller-storage-downgrade <<'APT'
DPkg::Pre-Install-Pkgs {"/usr/local/lib/nex/storage-downgrade-guard --controller";};
DPkg::Tools::Options::/usr/local/lib/nex/storage-downgrade-guard::Version "3";
APT
    cat > /etc/apt/sources.list.d/nex.sources <<APT
Types: deb
URIs: $repo
Suites: nex
Components: main
Architectures: amd64
Signed-By: /usr/share/keyrings/nex-archive-keyring.gpg
APT
    # Prefer the packaged unit over an older appliance copy under /etc.
    if [ -f /etc/systemd/system/nex-controller.service ]; then
        rm -f /etc/systemd/system/nex-controller.service
    fi
    # Drop interim appliance-only update units once the package owns them.
    rm -f /etc/systemd/system/nex-controller-update.path \
        /etc/systemd/system/nex-controller-update.service
    deb-systemd-helper enable nex-controller.service
    deb-systemd-helper enable nex-controller-update.path
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
        # Do not restart here during apply-update; the helper starts after dpkg.
        # First installs and manual dpkg still need the service up.
        if [ ! -f /var/lib/nex-controller/pending-update.json ]; then
            deb-systemd-invoke restart nex-controller.service || true
        fi
        deb-systemd-invoke start nex-controller-update.path || true
    fi
fi
