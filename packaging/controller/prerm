#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-only
set -eu
if [ "$1" = remove ]; then
    /usr/local/lib/nex/storage-downgrade-guard --controller --check
    if [ -d /run/systemd/system ]; then
        deb-systemd-invoke stop nex-controller-update.path || true
        deb-systemd-invoke stop nex-controller.service || true
    fi
    deb-systemd-helper disable nex-controller-update.path
    deb-systemd-helper disable nex-controller.service
    # Remove the generated apt source so removal never leaves a source whose key is gone.
    rm -f "${DPKG_ROOT:-}/etc/apt/sources.list.d/nex.sources" "${DPKG_ROOT:-}/etc/apt/apt.conf.d/91nex-controller-storage-downgrade"
fi
