#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-only
set -eu
if [ "$1" = remove ]; then
    if [ -d /run/systemd/system ]; then
        deb-systemd-invoke stop nex-controller-update.path || true
        deb-systemd-invoke stop nex-controller.service || true
    fi
    deb-systemd-helper disable nex-controller-update.path
    deb-systemd-helper disable nex-controller.service
fi
