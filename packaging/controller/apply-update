#!/usr/bin/python3
# SPDX-License-Identifier: AGPL-3.0-only
"""Root helper: apply a pending nex-controller package update.

Runs outside nex-controller.service, so apt is never killed part-way through a dpkg
transaction by the service restart its own postinst triggers. apt owns the download,
GPG verification and dependency resolution against the signed Nex archive that the
package configured at install time; this helper only sequences the upgrade and
reports progress back to the web UI.
"""
import json
import os
from pathlib import Path
import subprocess
import sys
import time

STATE = Path('/var/lib/nex-controller')
PENDING = Path('/var/lib/nex-controller/pending-update.json')
PROGRESS = STATE / 'update-progress.json'
DEFAULT_REPO = 'https://nexvirtualization.com/apt'
SERVICE = 'nex-controller.service'
APT_SOURCE = Path('/etc/apt/sources.list.d/nex.sources')
APT_KEYRING = '/usr/share/keyrings/nex-archive-keyring.gpg'
APT = ['apt-get', '-q', '-o', 'Dpkg::Options::=--force-confold',
       '-o', 'DPkg::Lock::Timeout=60']
APT_ENV = {**os.environ, 'DEBIAN_FRONTEND': 'noninteractive', 'LC_ALL': 'C'}


def normalize_repo(repo):
    from urllib.parse import urlparse
    import ipaddress

    repo = (repo or '').rstrip('/')
    if not repo:
        return DEFAULT_REPO
    parsed = urlparse(repo)
    if parsed.scheme != 'http' or not parsed.hostname:
        return repo
    try:
        ip = ipaddress.ip_address(parsed.hostname)
    except ValueError:
        return repo
    if ip.is_loopback or ip.is_private or ip.is_link_local:
        return DEFAULT_REPO
    return repo


def fail(message):
    write_progress('failed', 0, error=message)
    print(message, file=sys.stderr)
    sys.exit(1)


def restart_then_fail(message):
    """A failed upgrade must not leave the management plane stopped."""
    run(['systemctl', 'start', SERVICE], check=False)
    fail(message)


def write_progress(phase, percent, message='', error=''):
    payload = {'phase': phase, 'percent': int(percent)}
    if message:
        payload['message'] = message
    if error:
        payload['error'] = error
    tmp = PROGRESS.with_suffix('.tmp')
    tmp.write_text(json.dumps(payload) + '\n')
    os.chmod(tmp, 0o600)
    tmp.replace(PROGRESS)


def load_pending():
    if not PENDING.is_file():
        fail('no pending update')
    data = json.loads(PENDING.read_text())
    package = data.get('package') or 'nex-controller'
    repo = normalize_repo(data.get('repo_url') or DEFAULT_REPO)
    conf = Path('/etc/nex/updates.conf')
    try:
        conf.parent.mkdir(parents=True, exist_ok=True)
        conf.write_text('repo_url=' + repo + '\n')
        os.chmod(conf, 0o644)
    except OSError:
        pass
    return package, repo


def write_apt_source(repo):
    """Keep the archive source aligned with a repo URL changed since install."""
    content = ('Types: deb\n'
               f'URIs: {repo.rstrip("/")}\n'
               'Suites: nex\n'
               'Components: main\n'
               'Architectures: amd64\n'
               f'Signed-By: {APT_KEYRING}\n')
    try:
        if APT_SOURCE.is_file() and APT_SOURCE.read_text() == content:
            return
        APT_SOURCE.parent.mkdir(parents=True, exist_ok=True)
        tmp = APT_SOURCE.with_suffix('.tmp')
        tmp.write_text(content)
        os.chmod(tmp, 0o644)
        tmp.replace(APT_SOURCE)
    except OSError as error:
        fail(f'could not write {APT_SOURCE}: {error}')


def run(cmd, check=True):
    return subprocess.run(cmd, check=check, text=True, capture_output=True)


def installed_version(package):
    result = run(['dpkg-query', '-W', '-f=${Version}', package], check=False)
    return result.stdout.strip()


def service_active():
    return run(['systemctl', 'is-active', '--quiet', SERVICE], check=False).returncode == 0


def ensure_service_running():
    run(['systemctl', 'daemon-reload'], check=False)
    run(['systemctl', 'reset-failed', SERVICE], check=False)
    # Credentials must stay readable by the service user after dpkg.
    conf = Path('/etc/nex-controller')
    state = Path('/var/lib/nex-controller')
    if conf.is_dir():
        run(['chown', '-R', 'nex-controller:nex-controller', str(conf)], check=False)
    if state.is_dir():
        run(['chown', '-R', 'nex-controller:nex-controller', str(state)], check=False)
    started = run(['systemctl', 'start', SERVICE], check=False)
    for _ in range(30):
        if service_active():
            return
        time.sleep(0.5)
    detail = run(['systemctl', 'status', '--no-pager', '-l', SERVICE], check=False)
    logs = run(['journalctl', '-u', SERVICE, '-n', '40', '--no-pager'], check=False)
    message = 'controller service failed to start'
    if started.stderr:
        message += ': ' + started.stderr.strip()
    if detail.stdout:
        message += '\n' + detail.stdout.strip()
    if logs.stdout:
        message += '\n' + logs.stdout.strip()
    fail(message[:4000])


def main():
    if os.geteuid() != 0:
        fail('root required')
    STATE.mkdir(mode=0o700, exist_ok=True)
    package, repo = load_pending()
    write_apt_source(repo)
    before = installed_version(package)

    write_progress('downloading', 10, message='Refreshing package index')
    # A partly failing refresh still leaves usable lists; the install below is the
    # authority on whether a newer version was actually available.
    subprocess.run(APT + ['update'], env=APT_ENV, check=False, capture_output=True, text=True)

    write_progress('installing', 50, message='Installing package')
    run(['systemctl', 'stop', SERVICE], check=False)
    result = subprocess.run(APT + ['install', '-y', '--only-upgrade', package],
                            env=APT_ENV, check=False, capture_output=True, text=True)
    if result.returncode != 0:
        restart_then_fail('apt failed: ' + ((result.stderr or result.stdout or '')[-2000:]))
    # apt exits 0 when the installed version is already the candidate, so compare
    # rather than trusting the exit status to mean an upgrade happened.
    if installed_version(package) == before:
        restart_then_fail(f'no newer {package} available from {repo}')

    write_progress('restarting', 98, message='Restarting service')
    ensure_service_running()
    PENDING.unlink(missing_ok=True)
    write_progress('done', 100, message='Update complete')


if __name__ == '__main__':
    main()
