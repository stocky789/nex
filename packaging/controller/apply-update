"""Root helper: apply a pending nex-controller package update."""
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import time
import urllib.request

STATE = Path('/var/lib/nex-controller')
PENDING = Path('/var/lib/nex-controller/pending-update.json')
PROGRESS = STATE / 'update-progress.json'
DEFAULT_REPO = 'https://nexvirtualization.com/apt'
SERVICE = 'nex-controller.service'


def normalize_repo(repo):
    from urllib.parse import urlparse
    import ipaddress

    repo = (repo or '').rstrip('/')
    if not repo:
        return DEFAULT_REPO
    parsed = urlparse(repo)
    if parsed.scheme != 'http' or not parsed.hostname:
        return repo
    try:
        ip = ipaddress.ip_address(parsed.hostname)
    except ValueError:
        return repo
    if ip.is_loopback or ip.is_private or ip.is_link_local:
        return DEFAULT_REPO
    return repo


def fail(message):
    write_progress('failed', 0, error=message)
    print(message, file=sys.stderr)
    sys.exit(1)


def write_progress(phase, percent, message='', error=''):
    payload = {'phase': phase, 'percent': int(percent)}
    if message:
        payload['message'] = message
    if error:
        payload['error'] = error
    tmp = PROGRESS.with_suffix('.tmp')
    tmp.write_text(json.dumps(payload) + '\n')
    os.chmod(tmp, 0o600)
    tmp.replace(PROGRESS)


def load_pending():
    if not PENDING.is_file():
        fail('no pending update')
    data = json.loads(PENDING.read_text())
    package = data.get('package') or 'nex-controller'
    repo = normalize_repo(data.get('repo_url') or DEFAULT_REPO)
    conf = Path('/etc/nex/updates.conf')
    try:
        conf.parent.mkdir(parents=True, exist_ok=True)
        conf.write_text('repo_url=' + repo + '\n')
        os.chmod(conf, 0o644)
    except OSError:
        pass
    return package, repo


def fetch_index(repo):
    with urllib.request.urlopen(repo + '/updates.json', timeout=60) as response:
        return json.load(response)


def download(repo, info, dest):
    filename = info['filename']
    url = repo + '/' + filename.lstrip('/')
    path = dest / Path(filename).name
    expected = int(info.get('size') or 0)
    req = urllib.request.Request(url)
    with urllib.request.urlopen(req, timeout=3600) as response, path.open('wb') as out:
        total = int(response.headers.get('Content-Length') or expected or 0)
        digest = hashlib.sha256()
        read = 0
        last = -1
        while True:
            chunk = response.read(1024 * 1024)
            if not chunk:
                break
            out.write(chunk)
            digest.update(chunk)
            read += len(chunk)
            if total > 0:
                pct = min(100, int(read * 100 / total))
                if pct != last:
                    last = pct
                    write_progress('downloading', pct, message='Downloading package')
    if digest.hexdigest().lower() != info['sha256'].lower():
        fail('sha256 mismatch')
    write_progress('downloading', 100, message='Downloading package')
    return path


def run(cmd, check=True):
    return subprocess.run(cmd, check=check, text=True, capture_output=True)


def service_active():
    return run(['systemctl', 'is-active', '--quiet', SERVICE], check=False).returncode == 0


def ensure_service_running():
    run(['systemctl', 'daemon-reload'], check=False)
    run(['systemctl', 'reset-failed', SERVICE], check=False)
    # Credentials must stay readable by the service user after dpkg.
    conf = Path('/etc/nex-controller')
    state = Path('/var/lib/nex-controller')
    if conf.is_dir():
        run(['chown', '-R', 'nex-controller:nex-controller', str(conf)], check=False)
    if state.is_dir():
        run(['chown', '-R', 'nex-controller:nex-controller', str(state)], check=False)
    started = run(['systemctl', 'start', SERVICE], check=False)
    for _ in range(30):
        if service_active():
            return
        time.sleep(0.5)
    detail = run(['systemctl', 'status', '--no-pager', '-l', SERVICE], check=False)
    logs = run(['journalctl', '-u', SERVICE, '-n', '40', '--no-pager'], check=False)
    message = 'controller service failed to start'
    if started.stderr:
        message += ': ' + started.stderr.strip()
    if detail.stdout:
        message += '\n' + detail.stdout.strip()
    if logs.stdout:
        message += '\n' + logs.stdout.strip()
    fail(message[:4000])


def main():
    if os.geteuid() != 0:
        fail('root required')
    STATE.mkdir(mode=0o700, exist_ok=True)
    package, repo = load_pending()
    write_progress('downloading', 0, message='Downloading package')
    index = fetch_index(repo)
    info = (index.get('packages') or {}).get(package)
    if not info or not info.get('filename') or not info.get('sha256'):
        fail('package missing from updates index')
    with tempfile.TemporaryDirectory(prefix='nex-controller-update-') as temporary:
        deb = download(repo, info, Path(temporary))
        write_progress('installing', 90, message='Installing package')
        run(['systemctl', 'stop', SERVICE], check=False)
        result = run(['dpkg', '-i', str(deb)], check=False)
        if result.returncode != 0:
            fail('dpkg failed: ' + ((result.stderr or result.stdout or '')[-2000:]))
    write_progress('restarting', 98, message='Restarting service')
    ensure_service_running()
    PENDING.unlink(missing_ok=True)
    write_progress('done', 100, message='Update complete')


if __name__ == '__main__':
    main()
