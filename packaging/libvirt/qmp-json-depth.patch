+static void
+testQemuMonitorJSONGetBlockInfoFree(void *opaque)
+{
+    struct qemuDomainDiskInfo *info = opaque;
+
+    g_free(info->nodename);
+    g_free(info);
+}
+
+
+static int
+testQemuMonitorJSONGetBlockInfoDepth(const testGenericData *data,
+                                     size_t imageDepth,
+                                     bool expectSuccess)
+{
+    virDomainXMLOption *xmlopt = data->xmlopt;
+    g_auto(virBuffer) replyBuf = VIR_BUFFER_INITIALIZER;
+    g_autofree char *reply = NULL;
+    g_autoptr(GHashTable) blockDevices = virHashNew(testQemuMonitorJSONGetBlockInfoFree);
+    g_autoptr(qemuMonitorTest) test = NULL;
+    g_autoptr(virJSONValue) defaultReply = NULL;
+    struct qemuDomainDiskInfo *info;
+    size_t i;
+
+    if (!(test = qemuMonitorTestNewSchema(xmlopt, data->schema)))
+        return -1;
+
+    virBufferAddLit(&replyBuf,
+                    "{\"return\":[{\"device\":\"drive-test\","
+                    "\"removable\":false,\"inserted\":{"
+                    "\"node-name\":\"test-node\",\"image\":");
+
+    for (i = 0; i < imageDepth; i++) {
+        virBufferAsprintf(&replyBuf, "{\"filename\":\"disk-%zu.qcow2\"", i);
+        if (i + 1 < imageDepth)
+            virBufferAddLit(&replyBuf, ",\"backing-image\":");
+    }
+
+    for (i = 1; i < imageDepth; i++)
+        virBufferAddLit(&replyBuf, "}");
+    virBufferAddLit(&replyBuf, "}}}]}");
+    reply = virBufferContentAndReset(&replyBuf);
+
+    if (expectSuccess) {
+        defaultReply = virJSONValueFromString(reply);
+        if (defaultReply || !virGetLastError() ||
+            !strstr(virGetLastError()->message, "nesting too deep")) {
+            virReportError(VIR_ERR_INTERNAL_ERROR, "%s",
+                           "Default JSON parser depth changed for QMP replies");
+            return -1;
+        }
+        virResetLastError();
+    }
+
+    if (qemuMonitorTestAddItem(test, "query-block", reply) < 0)
+        return -1;
+
+    if (qemuMonitorJSONGetBlockInfo(qemuMonitorTestGetMonitor(test), blockDevices) < 0) {
+        if (expectSuccess)
+            return -1;
+
+        if (!virGetLastError() ||
+            !strstr(virGetLastError()->message, "nesting too deep")) {
+            virReportError(VIR_ERR_INTERNAL_ERROR, "%s",
+                           "Deep query-block reply failed for an unexpected reason");
+            return -1;
+        }
+        virResetLastError();
+        return 0;
+    }
+
+    if (!expectSuccess) {
+        virReportError(VIR_ERR_INTERNAL_ERROR, "%s",
+                       "Over-depth query-block reply was accepted");
+        return -1;
+    }
+
+    info = virHashLookup(blockDevices, "test");
+    if (!info || STRNEQ_NULLABLE(info->nodename, "test-node")) {
+        virReportError(VIR_ERR_INTERNAL_ERROR, "%s",
+                       "Deep query-block reply did not preserve disk information");
+        return -1;
+    }
+
+    return 0;
+}
+
+
+static int
+testQemuMonitorJSONqemuMonitorJSONGetBlockInfoDeep(const void *opaque)
+{
+    const testGenericData *data = opaque;
+
+    if (testQemuMonitorJSONGetBlockInfoDepth(data,
+                                             QEMU_DOMAIN_STORAGE_SOURCE_CHAIN_MAX_DEPTH,
+                                             true) < 0)
+        return -1;
+
+    return testQemuMonitorJSONGetBlockInfoDepth(data,
+                                                QEMU_DOMAIN_STORAGE_SOURCE_CHAIN_MAX_DEPTH + 1,
+                                                false);
+}
