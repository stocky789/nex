worker_processes auto;
pid /run/nex-website/nginx.pid;
error_log /var/log/nex-website/error.log warn;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    log_format nex '$remote_addr - $request $status $body_bytes_sent';
    access_log /var/log/nex-website/access.log nex;
    sendfile on;
    server_tokens off;
    client_body_temp_path /run/nex-website/client_body;
    proxy_temp_path /run/nex-website/proxy;
    fastcgi_temp_path /run/nex-website/fastcgi;
    uwsgi_temp_path /run/nex-website/uwsgi;
    scgi_temp_path /run/nex-website/scgi;

    server {
        listen @NEX_WEBSITE_LISTEN@;
        server_name _;
        root /srv/nex-website/current;
        index index.html;
        autoindex off;
        absolute_redirect off;

        # The root-owned current selector is the document root. No served artifact
        # beneath it may be a symlink.
        disable_symlinks on from=$document_root;

        add_header Content-Security-Policy "default-src 'self'; base-uri 'none'; connect-src 'self'; font-src 'self'; form-action 'none'; frame-ancestors 'none'; img-src 'self'; object-src 'none'; script-src 'self'; style-src 'self'" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;

        location ~ /\. {
            access_log off;
            log_not_found off;
            deny all;
        }

        # Release downloads (GET/HEAD only). The publisher adds an index to each retained
        # version; direct payload URLs remain available to the network installer.
        location /downloads/ {
            alias /srv/nex-downloads/;
            # `latest` is an atomically switched release symlink owned by the publishing
            # account, so this location must permit that one controlled indirection.
            disable_symlinks off;
            autoindex on;
            autoindex_exact_size off;
            absolute_redirect off;
            limit_except GET HEAD { deny all; }
            types {
                text/html html;
                application/json json;
                application/x-iso9660-image iso;
                text/plain sha256;
            }
            default_type application/octet-stream;
            # Location-level headers replace server add_header inheritance. Omit CSP so
            # download clients are not affected by the website policy.
            add_header Referrer-Policy "no-referrer" always;
            add_header X-Content-Type-Options "nosniff" always;
            add_header X-Frame-Options "DENY" always;
        }

        # Signed update tree for Nex Core hosts (GET/HEAD only, no listing). Hosts fetch blobs with
        # HTTP Range; every file is signed or hash-pinned, so nothing here needs to be secret.
        location /updates/ {
            alias /srv/nex-updates/;
            disable_symlinks on;
            autoindex off;
            absolute_redirect off;
            limit_except GET HEAD { deny all; }
            types {
                application/json json;
            }
            default_type application/octet-stream;
            add_header Cache-Control "no-cache" always;
            add_header Referrer-Policy "no-referrer" always;
            add_header X-Content-Type-Options "nosniff" always;
            add_header X-Frame-Options "DENY" always;
        }

        location / {
            limit_except GET HEAD { deny all; }
            try_files $uri $uri/ =404;
        }
    }
}
