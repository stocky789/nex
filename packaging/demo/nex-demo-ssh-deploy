"""Forced command for the dedicated demo publishing key; no shell or forwarding."""
import os
import re
import sys

command = os.environ.get('SSH_ORIGINAL_COMMAND', '')
match = re.fullmatch(r'sudo -n /usr/local/sbin/nex-demo-deploy ([0-9a-f]{40})', command)
if match is None:
    print('nex-demo-ssh-deploy: only commit-tagged demo publication is permitted', file=sys.stderr)
    sys.exit(1)
os.execv('/usr/bin/sudo', ('sudo', '-n', '/usr/local/sbin/nex-demo-deploy', match[1]))
