worker_processes 1;
pid /run/nex-demo-proxy/nginx.pid;
error_log stderr warn;

events { worker_connections 256; }

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    # Avoid an unbounded, request-controlled sink on the shared website disk.
    access_log off;
    server_tokens off;
    client_max_body_size 16k;
    client_body_buffer_size 16k;
    client_body_timeout 10s;
    client_header_timeout 10s;
    keepalive_timeout 30s;
    send_timeout 30s;
    client_body_temp_path /run/nex-demo-proxy/client_body;
    proxy_temp_path /run/nex-demo-proxy/proxy;
    fastcgi_temp_path /run/nex-demo-proxy/fastcgi;
    uwsgi_temp_path /run/nex-demo-proxy/uwsgi;
    scgi_temp_path /run/nex-demo-proxy/scgi;
    # Empty unless the root operator configures exact trusted HTTPS proxy peers.
    # Never trust XFF from arbitrary clients or broad networks.
    include /etc/nex-demo/trusted-proxies.conf;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    # Without trusted proxies, each TCP peer shares one rate-limit bucket.
    limit_req_zone $binary_remote_addr zone=requests:1m rate=30r/s;
    # Only login attempts (POST) count; an empty key is not rate limited.
    map $request_method $login_key { POST $binary_remote_addr; default ""; }
    limit_req_zone $login_key zone=login:1m rate=5r/m;
    # Interrupted downloads of the ~130 MB archive resume with Range requests.
    limit_req_zone $binary_remote_addr zone=source:1m rate=10r/m;
    limit_conn_zone $binary_remote_addr zone=connections:1m;
    limit_req_status 429;
    limit_conn_status 429;

    upstream demo { server unix:/run/nex-demo/demo.sock; }

    server {
        listen @NEX_DEMO_LISTEN@ default_server;
        server_name _;
        return 444;
    }

    server {
        listen @NEX_DEMO_LISTEN@;
        server_name @NEX_DEMO_HOST@;
        limit_conn connections 64;
        limit_req zone=requests burst=120 nodelay;

        # This listener is PRIVATE HTTP behind the configured HTTPS terminator.
        # The edge must preserve Host and Origin and must not expose this port.
        proxy_set_header Host @NEX_DEMO_HOST@;
        proxy_set_header X-Forwarded-Host @NEX_DEMO_HOST@;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Real-IP "";
        proxy_set_header Forwarded "";
        proxy_set_header Authorization "";
        proxy_set_header Proxy-Authorization "";
        proxy_set_header Connection "";
        proxy_http_version 1.1;
        proxy_connect_timeout 2s;
        proxy_read_timeout 30s;
        proxy_send_timeout 10s;
        proxy_request_buffering on;
        proxy_buffering off;
        proxy_max_temp_file_size 0;

        location = /healthz {
            allow 127.0.0.1;
            allow ::1;
            deny all;
            limit_except GET { deny all; }
            proxy_pass http://demo;
            access_log off;
        }
        location = /api/v1/session {
            limit_req zone=requests burst=120 nodelay;
            limit_req zone=login burst=10 nodelay;
            limit_except GET POST DELETE { deny all; }
            proxy_pass http://demo;
        }
        location = /source {
            limit_req zone=requests burst=120 nodelay;
            limit_req zone=source burst=6 nodelay;
            limit_except GET { deny all; }
            proxy_pass http://demo;
        }
        # Let the network-disabled adapter return its JSON read-only refusal.
        # Rejecting these at nginx would give the shared UI an HTML parse error.
        location /api/ {
            limit_except GET POST PUT PATCH DELETE OPTIONS { deny all; }
            proxy_pass http://demo;
        }
        location / {
            limit_except GET { deny all; }
            proxy_pass http://demo;
        }
    }
}
