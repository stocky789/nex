[Unit]
Description=Nex Core management agent (development)
After=network-online.target libvirtd.service
Wants=network-online.target

[Service]
Type=simple
User=root
StateDirectory=nex-core-agent
StateDirectoryMode=0700
UMask=0077
ExecStartPre=/bin/mkdir -p /var/lib/libvirt/images
ExecStartPre=/bin/chmod 0711 /var/lib/libvirt/images
ExecStart=/usr/local/lib/nex/nex-core-agent run --state-dir /var/lib/nex-core-agent --heartbeat 10s --probe-interval 10s --probe-timeout 3s
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
# The QEMU access probe intentionally drops to libvirt-qemu with runuser.
# Keep only the capability needed for that UID transition.
AmbientCapabilities=CAP_SETUID
ProtectSystem=strict
ReadWritePaths=-/var/lib/libvirt/images
ReadWritePaths=-/etc/network
# Core requests host-visible repository mounts through system-manager-owned .mount units;
# the agent must never rely on mounts made inside this service's private namespace.
ReadWritePaths=-/var/lib/nex-storage
ReadWritePaths=-/var/lib/nex-core-agent/storage-credentials
ReadWritePaths=-/etc/systemd/system
# Debian open-iscsi persists Nex-owned node records here and serializes iscsiadm updates.
ReadWritePaths=-/var/lib/iscsi
ReadWritePaths=-/run/lock/iscsi
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
