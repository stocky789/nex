[Unit]
Description=Nex Core management agent (development)
After=network-online.target time-sync.target libvirtd.service
Wants=network-online.target

[Service]
Type=simple
User=root
StateDirectory=nex-core-agent
StateDirectoryMode=0700
UMask=0077
# Mount credentials are sealed with systemd-creds; make sure the host key exists (runs unsandboxed).
ExecStartPre=+-/usr/bin/systemd-creds setup
# The backup credential receipt key is sealed in the state directory and loaded into the service
# as a credential. A missing file would fail the unit, so the first start creates it here; Core
# creates it itself only when it is missing while running.
ExecStartPre=+/bin/sh -c 'f=/var/lib/nex-core-agent/backup-credential-key/key.cred; [ -e "$f" ] || { mkdir -p -m 0700 "${f%/*}" && head -c 32 /dev/urandom | systemd-creds --no-ask-password encrypt --name=nex-backup-key - "$f"; }'
LoadCredentialEncrypted=nex-backup-key:/var/lib/nex-core-agent/backup-credential-key/key.cred
ExecStartPre=/bin/mkdir -p /var/lib/libvirt/images
ExecStartPre=/bin/chmod 0711 /var/lib/libvirt/images
ExecStart=/usr/local/lib/nex/nex-core-agent run --state-dir /var/lib/nex-core-agent --heartbeat 10s --probe-interval 10s --probe-timeout 3s
# Restart=always, not on-failure: a management-network change arms a rollback that only
# runs when this service is running again, so a clean exit (an exit 0, a killed process
# reaped as success) must not leave the host on an unconfirmed network with nothing armed.
# `systemctl stop` and a package upgrade still stop the unit; only an exit does not.
Restart=always
RestartSec=5
NoNewPrivileges=yes
# The QEMU access probe intentionally drops to libvirt-qemu with runuser.
# Keep only the capability needed for that UID transition.
AmbientCapabilities=CAP_SETUID
ProtectSystem=strict
ReadWritePaths=-/var/lib/libvirt/images
ReadWritePaths=-/etc/network
# Core requests host-visible repository mounts through system-manager-owned .mount units;
# the agent must never rely on mounts made inside this service's private namespace.
ReadWritePaths=-/var/lib/nex-storage
ReadWritePaths=-/var/lib/nex-core-agent/storage-credentials
ReadWritePaths=-/var/lib/nex-core-agent/backup-credential-key
# Root-only fence password scripts are consumed by Pacemaker, never passed through Controller.
ReadWritePaths=-/var/lib/nex-core-agent/storage-cluster
ReadWritePaths=-/etc/systemd/system
# Debian open-iscsi persists Nex-owned node records here and serializes iscsiadm updates.
ReadWritePaths=-/var/lib/iscsi
ReadWritePaths=-/run/lock/iscsi
# Clustered GFS2 configuration owns this one generated Corosync projection.
ReadWritePaths=-/etc/corosync
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
